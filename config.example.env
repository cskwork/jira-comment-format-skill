# 복사해서 config.env 로 만들고 값을 채운다: cp config.example.env config.env
# config.env 는 .gitignore 대상이다. 실제 값을 이 예시 파일에 쓰지 않는다.
# Copy to config.env (gitignored) and fill in. Never put real values in this example file.

# Jira (비우면 `acli jira auth status` 의 Site·Email 사용)
JIRA_SITE=<your-site>
JIRA_EMAIL=you@example.com
# API 토큰: JIRA_API_TOKEN 환경변수 또는 아래 파일(권한 600). 토큰 값을 여기에 쓰지 않는다.
JIRA_TOKEN_FILE=~/.config/jira/token
# 게시 전 중복 확인에서 "내 댓글"을 고를 표시 이름
JIRA_MY_NAME=<your display name>

# 상태 이동 워크플로(쉼표 구분, 비우면 jira_status_check.py 기본값)
JIRA_STATUS_ORDER=
JIRA_STATUS_DEV=
JIRA_STATUS_STAGING=
JIRA_STATUS_LATER=

# 기획자용 검사에 더할 프로젝트 고유 이름 정규식(저장소·서비스 이름 등). 여러 개는 || 로 잇는다.
# 예: PLANNER_LINT_EXTRA=\bmyapp-(?:api|web)\b||\bbilling-service\b
PLANNER_LINT_EXTRA=

# 화면 캡처 대상
DEV_URL=https://dev.example.com
STAGING_URL=https://staging.example.com

# 개발자 노트 보드 — Jira에 남기지 않는 개발자용 기록(dev_note.py)
DEV_NOTE_CLI=~/.local/bin/devnote-cli
DEV_NOTE_BASE=https://notes.example.com
DEV_NOTE_SPACE=<SPACE>
DEV_NOTE_WORKSPACE=
